# Public HTTPS storefront handoff. Leave empty until commerce is approved.
VITE_SHOP_URL=

# Public HTTPS waitlist provider. Empty means the interface shows REGISTRATION PENDING.
VITE_WAITLIST_URL=

# Approved public social profiles only. Empty values render APPROVED CHANNELS PENDING.
VITE_INSTAGRAM_URL=
VITE_TIKTOK_URL=
VITE_YOUTUBE_URL=

# Google Analytics 4. Leave empty until a real Measurement ID is approved.
VITE_GA_MEASUREMENT_ID=

# Analytics stays disabled unless consent has been granted by the approved consent layer.
VITE_GA_ANALYTICS_CONSENT=denied

# Google Search Console HTML-tag verification token. Use only the token value.
VITE_GOOGLE_SITE_VERIFICATION=
